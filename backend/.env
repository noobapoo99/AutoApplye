GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
GEMINI_FLASH_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/autoapply
SERPAPI_KEY=your-serpapi-key
GMAIL_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-client-secret
GMAIL_REDIRECT_URI=http://localhost:8000/api/v1/auth/gmail/callback
SECRET_KEY=replace-with-a-long-random-secret
ENVIRONMENT=development
LOG_LEVEL=INFO
RATE_LIMIT_CAPACITY=10
RATE_LIMIT_LEAK_RATE=0.5
HALLUCINATION_THRESHOLD=0.35
RESUME_MATCH_THRESHOLD=0.7
